# Mongo / app (existing)
# MONGODB_URI=
# JWT_SECRET=

# ── WhatsApp Cloud API (Meta) — event & competition registrations ──
# Create an app at https://developers.facebook.com/ → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Restaurant number that receives every new registration (with country code, no +)
# Example India: 919876543210
WHATSAPP_ADMIN_NUMBER=

# Optional
# WHATSAPP_API_VERSION=v21.0
# Also message the guest who registered (needs a 24h window or an approved template)
# WHATSAPP_SEND_GUEST_CONFIRM=true
# WHATSAPP_GUEST_TEMPLATE=registration_confirmation
# WHATSAPP_GUEST_TEMPLATE_LANG=en
